play:inline-block;font-size:11.5px;letter-spacing:.14em;font-weight:800;color:var(--violet-deep);background:var(--violet-soft);border-radius:999px;padding:3px 10px;margin-left:10px;vertical-align:3px}\n  .price{text-align:right;line-height:1.3}\n  .price .num{font-size:30px;font-weight:800;letter-spacing:-.02em}\n  .price .num small{font-size:14px;font-weight:600;color:var(--muted)}\n  .price .yr{display:block;font-size:13px;color:var(--muted)}\n  .plan ul{margin-top:16px;padding-left:0;list-style:none}\n  .plan ul li{position:relative;padding-left:20px;font-size:15.4px;color:var(--ink-soft)}\n  .plan ul li::before{content:\"\";position:absolute;left:0;top:.68em;width:8px;height:8px;background:var(--violet-soft);border-left:3px solid var(--violet);border-radius:1px}\n  .plan-note{margin-top:16px;font-size:13.5px;color:var(--muted);border-top:1px dashed var(--line);padding-top:12px}\n  .plans-foot{margin-top:22px;font-size:14px;color:var(--ink-soft);max-width:64ch}\n\n  /* ---------- clients ---------- */\n  .clients{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n  .client{background:var(--panel);border:1px solid var(--line);border-left:6px solid var(--line);border-radius:0 12px 12px 0;padding:18px 20px}\n  .client h3{font-size:16px;margin-bottom:6px}\n  .client p{margin:0;font-size:14.4px;color:var(--ink-soft)}\n  .client .state{display:inline-block;font-size:11.5px;letter-spacing:.12em;font-weight:800;color:var(--muted);margin-bottom:8px}\n\n  /* ---------- faq : details ---------- */\n  .faq{display:grid;gap:12px;max-width:860px}\n  details{background:var(--panel);border:1px solid var(--line);border-left:6px solid var(--violet-soft);border-radius:0 12px 12px 0}\n  details[open]{border-left-color:var(--violet)}\n  summary{cursor:pointer;list-style:none;padding:16px 20px;font-weight:700;font-size:16px}\n  summary::-webkit-details-marker{display:none}\n  summary::after{content:\"+\";float:right;color:var(--violet-deep);font-weight:800;margin-left:12px}\n  details[open] summary::after{content:\"–\"}\n  details .a{padding:0 20px 18px;color:var(--ink-soft);font-size:15.2px}\n  details .a p:last-child{margin-bottom:0}\n\n  /* ---------- closing ---------- */\n  .closing{background:var(--violet);color:#fff;border-radius:18px;padding:34px 32px;margin:8px 0 0}\n  .closing h2{font-size:clamp(20px,3vw,26px);font-weight:800;margin-bottom:10px}\n  .closing p{color:#e9e3ff;max-width:62ch;margin-bottom:0}\n\n  footer{padding:36px 0 20px;color:var(--muted);font-size:13.5px}\n\n  /* ---------- bottom fixed nav ---------- */\n  .bottomnav{position:fixed;left:0;right:0;bottom:0;z-index:20;background:rgba(247,248,250,.94);border-top:1px solid var(--line);backdrop-filter:blur(6px)}\n  .bottomnav ul{max-width:1080px;margin:0 auto;padding:0 20px;list-style:none;display:flex;gap:6px;overflow-x:auto;align-items:center;height:58px}\n  .bottomnav a{display:block;white-space:nowrap;border:none;padding:9px 12px;border-radius:8px;font-size:14px;font-weight:600;color:var(--ink-soft)}\n  .bottomnav a:hover{background:var(--violet-soft);color:var(--violet-deep)}\n  .bottomnav .mark{font-weight:800;color:var(--violet-deep);letter-spacing:.02em;margin-right:8px;font-size:14px}\n\n  @media (max-width:860px){\n    .dash{grid-template-columns:repeat(2,1fr)}\n    .tile.wide{grid-column:span 2}\n    .clients{grid-template-columns:1fr}\n  }\n  @media (max-width:560px){\n    .hero{padding:36px 0 24px}\n    .dash{grid-template-columns:1fr;gap:12px}\n    .tile.big,.tile.wide{grid-column:span 1}\n    .plan{padding:22px 20px}\n    .price{text-align:left}\n    .closing{padding:26px 22px;border-radius:14px}\n    .bottomnav a{padding:8px 10px;font-size:13.5px}\n  }\n</style><main>\n  <div class=\"wrap hero\">\n    <p class=\"eyebrow\">Estars · 订阅说明</p>\n    <h1 class=\"hero-title\">白嫖<span>(Estars)</span>：先把账算明白，再决定要不要</h1>\n    <p class=\"hero-sub\">关于订阅，最省时间的做法不是听别人怎么说，而是把每一项权益摆在同一张桌面上。下面这组数字来自站内公示的套餐表，我们用同一套口径把它们重新排了一遍。</p>\n\n    <div class=\"dash\">\n      <div class=\"tile big\">\n        <p class=\"k\">套餐数量 / 阶梯</p>\n        <p class=\"v\">3 <small>档</small></p>\n        <p class=\"n\">基础版、旗舰版、团队版，按流量上限与在线设备数逐级递进。</p>\n      </div>\n      <div class=\"tile\">\n        <p class=\"k\">流量上限</p>\n        <p class=\"v\">100→1000<small>GB/月</small></p>\n        <p class=\"n\">三档之间的跨度。</p>\n      </div>\n      <div class=\"tile\">\n        <p class=\"k\">设备上限</p>\n        <p class=\"v\">3→20<small>台</small></p>\n        <p class=\"n\">同时在线数量。</p>\n      </div>\n      <div class=\"tile\">\n        <p class=\"k\">月付起价</p>\n        <p class=\"v\">¥15<small>/月</small></p>\n        <p class=\"n\">年付按公示价格折算。</p>\n      </div>\n      <div class=\"tile wide\">\n        <p class=\"k\">三档月付价格分布</p>\n        <p class=\"v\">15 · 35 · 85</p>\n        <p class=\"n\">单位：元/月。中间档与最高档之间差距最大。</p>\n        <div class=\"bars\">\n          <i></i>\n          <i class=\"on\"></i>\n          <i></i>\n        </div>\n      </div>\n      <div class=\"tile wide\">\n        <p class=\"k\">年付折算</p>\n        <p class=\"v\">10 <small>个月的价格</small></p>\n        <p class=\"n\">按公示年付价 ¥150 / ¥350 / ¥850，相当于月付的十个月用量。</p>\n      </div>\n    </div>\n  </div>\n\n  <section id=\"reading\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>这份说明怎么读</h2>\n        <p>写给第一次打开套餐页的人</p>\n      </div>\n      <p class=\"lede\">订阅页最容易出现的问题是：价格写在一处，权益写在另一处，最后你记住了数字，却忘了自己到底需要什么。所以我们把顺序调成——先看用途，再看容量，最后看价格。下面四个小节就是这个顺序。</p>\n\n      <div class=\"bar-card\">\n        <h3>第一步：先确认你每个月大概用多少</h3>\n        <p>流量是这套套餐里最刚性的分隔线：100GB、300GB、1000GB。多数人高估了自己的用量，也高估了自己同时开设备的数量。把上个月的记录翻出来看一眼，比读十篇测评有用。</p>\n      </div>\n      <div class=\"bar-card\">\n        <h3>第二步：数一数同时需要用几台设备</h3>\n        <p>3 台、5 台、20 台，这是另一条硬边界。注意是“同时在线”，不是“累计绑定”。家里一台、公司一台、手机一台，基本就顶到基础版的上限了。</p>\n      </div>\n      <div class=\"bar-card\">\n        <h3>第三步：判断你是否真的需要专线和优先支持</h3>\n        <p>旗舰版与团队版的附加项集中在线路类型与支持响应上。这些是“有就更好”的东西，不是“没有就用不了”的东西。先问自己上一次遇到问题卡了多久。</p>\n      </div>\n      <div class=\"bar-card\">\n        <h3>第四步：年付只是把同一件事延长</h3>\n        <p>年付价正好等于十个月月付。它不会解锁额外的权益，也不会提升档位。如果你的使用周期不确定，月付更诚实。</p>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>三档套餐，逐张摊开</h2>\n        <p>价格与权益按站内公示内容记录</p>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <h3>基础版</h3>\n            <div class=\"price\">\n              <span class=\"num\">¥15<small> / 月</small></span>\n              <span class=\"yr\">按年付 ¥150 / 年</span>\n            </div>\n          </div>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"plan-note\">适合单人、单设备为主的使用场景。如果你的设备数量刚好是三台，请留意每增加一台都会超出上限。</p>\n        </article>\n\n        <article class=\"plan featured\">\n          <div class=\"plan-top\">\n            <h3>旗舰版<span class=\"tag\">多数人的中间选项</span></h3>\n            <div class=\"price\">\n              <span class=\"num\">¥35<small> / 月</small></span>\n              <span class=\"yr\">按年付 ¥350 / 年</span>\n            </div>\n          </div>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线，针对游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <p class=\"plan-note\">与基础版相比，流量翻三倍、设备加两台，同时多出线路类型与支持通道的差别。它是三档里权益变化最密集的一档。</p>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-top\">\n            <h3>团队版</h3>\n            <div class=\"price\">\n              <span class=\"num\">¥85<small> / 月</small></span>\n              <span class=\"yr\">按年付 ¥850 / 年</span>\n            </div>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"plan-note\">面向多人共用与有内部网络规划的团队。定制路由这一项需要与对接方沟通，不是自助完成的设置项。</p>\n        </article>\n      </div>\n\n      <p class=\"plans-foot\">以上价格与权益为页面记录内容，具体以结算与购买页面所示为准。本站不代办任何交易，也不提供代付或折扣渠道。</p>\n    </div>\n  </section>\n\n  <section id=\"steps\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>从决定到用起来</h2>\n        <p>四个动作，按顺序做完即可</p>\n      </div>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <h3>对照用量与设备数选档</h3>\n          <p>把月流量和同时在线设备数写在纸上，和你看到的三个数字比一遍。两项都满足的最低一档，通常就是合适的档位。没有必要因为“以后可能用得更多”而提前升级。</p>\n        </div>\n        <div class=\"step\">\n          <h3>选择月付或年付</h3>\n          <p>年付等于把十个月的钱一次付清。如果你能确认自己一年内持续使用，它确实省下两个月；如果中途可能停用，月付的灵活性更有价值。</p>\n        </div>\n        <div class=\"step\">\n          <h3>在你自己的设备上完成配置</h3>\n          <p>账号开通后的配置步骤由服务方提供说明。请按官方渠道给出的指引操作，不要使用来源不明的配置文件或第三方转发的连接信息。</p>\n        </div>\n        <div class=\"step\">\n          <h3>记录你的用量，再回头调整</h3>\n          <p>用满一个月后回看数据：流量是否接近上限、设备是否经常挤占名额。这些实际数字比购买前的估算更可靠，也是决定要不要换档的唯一依据。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>客户端情况</h2>\n        <p>未获得来自官方的客户端清单，此处如实说明</p>\n      </div>\n      <div class=\"clients\">\n        <div class=\"client\">\n          <span class=\"state\">未公示</span>\n          <h3>桌面端</h3>\n          <p>本页不列具体的桌面客户端名称与版本，也没有任何下载链接。请在购买后以服务方给出的官方说明为准。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"state\">未公示</span>\n          <h3>移动端</h3>\n          <p>同样不提供移动端下载入口。任何声称是“官方安装包”的第三方链接都不建议点击。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"state\">未公示</span>\n          <h3>设备数与并发</h3>\n          <p>唯一可以确认的是三档套餐的设备同时在线上限：3 台、5 台、20 台。客户端形态不影响这一数字。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <h2>常见问题</h2>\n        <p>点击每条展开</p>\n      </div>\n      <div class=\"faq\">\n        <details>\n          <summary>“白嫖(Estars)”这个名字，是表示可以免费使用吗？</summary>\n          <div class=\"a\">\n            <p>不是。名字只是一个标识，本页记录的三档套餐均为付费订阅，价格分别是每月 ¥15、¥35、¥85。没有免费档位，也没有试用期之类的说明出现在公示内容中。如果你在其他地方看到“免费领取”的说法，请以官方页面为准，不要据此付款或交出账号信息。</p>\n          </div>\n        </details>\n        <details>\n          <summary>三档套餐最核心的区别是什么？</summary>\n          <div class=\"a\">\n            <p>两条硬指标：每月流量上限和同时在线设备数。基础版是 100GB 与 3 台，旗舰版是 300GB 与 5 台，团队版是 1000GB 与 20 台。除此之外的差别集中在线路与支持，包括基础版只有普通线路节点池，旗舰版增加 IPLC 专线与优先工单支持，团队版增加 VIP 高带宽节点、企业定制路由与专属客户经理。</p>\n          </div>\n        </details>\n        <details>\n          <summary>年付到底省了多少？</summary>\n          <div class=\"a\">\n            <p>按公示价格换算，年付金额正好等于十个月的月付。基础版 ¥15×10 = ¥150，旗舰版 ¥35×10 = ¥350，团队版 ¥85×10 = ¥850，与三档的年付价一一对应。它不改变任何权益，只改变付款周期。</p>\n          </div>\n        </details>\n        <details>\n          <summary>我同时用手机、平板和两台电脑，该选哪档？</summary>\n          <div class=\"a\">\n            <p>四台设备已经超过基础版的 3 台上限，只能考虑旗舰版或更高。选旗舰版还是团队版，接下来看流量：如果四台设备每月合计用量远低于 300GB，旗舰版就够；若接近或超过 300GB，再看团队版的 1000GB。</p>\n          </div>\n        </details>\n        <details>\n          <summary>“同时在线”是怎么算的？</summary>\n          <div class=\"a\">\n            <p>页面表述为同时在线设备数，也就是同一时刻保持连接的设备数量上限，而不是累计可以绑定的设备总数。这意味着你可以轮换使用不同设备，只要同一时刻不超过对应档位的数量。更细的判定规则以服务方说明为准，本页不做额外推断。</p>\n          </div>\n        </details>\n        <details>\n          <summary>流量当月没用完，会结转到下个月吗？</summary>\n          <div class=\"a\">\n            <p>公示内容只写了“每月”的流量额度，没有提到结转规则。因此这里不给结论。购买前如果需要确认，请直接通过官方渠道询问，并把答复留存下来，这比事后争议省事得多。</p>\n          </div>\n        </details>\n        <details>\n          <summary>IPLC 专线和普通线路，体感差别在哪？</summary>\n          <div class=\"a\">\n            <p>公示里对旗舰版的描述是“IPLC 专线游戏加速优化”，对基础版是“普通线路节点池”。这属于线路类型上的区别，但页面没有给出延迟、带宽或丢包等具体数值，所以本页不替它做性能承诺。是否值得为它多付每月二十元，取决于你对线路稳定性的实际敏感程度。</p>\n          </div>\n        </details>\n        <details>\n          <summary>团队版的“企业定制路由”需要自己配置吗？</summary>\n          <div class=\"a\">\n            <p>这通常需要与服务方沟通后确定，不是购买后自动生效的选项。如果你的团队有内部网络规划需求，建议在付款前就把具体需求讲清楚，确认可执行范围之后再决定。本页不提供配置方法。</p>\n          </div>\n        </details>\n        <details>\n          <summary>能提供客户端下载地址吗？</summary>\n          <div class=\"a\">\n            <p>不能。本页没有获得可靠的官方客户端清单与下载来源，因此客户端区块如实标注为未公示，并且不放置任何下载链接。请只从服务方官方渠道获取安装与配置信息。</p>\n          </div>\n        </details>\n        <details>\n          <summary>买错了档位可以退吗？</summary>\n          <div class=\"a\">\n            <p>本页没有关于退款政策的可靠信息，因此不做任何承诺或暗示。如果你在意这一点，请在付款前确认清楚，并把相关条款保存下来。任何“随时可退”的说法如果没有官方依据，都不应当作决策依据。</p>\n          </div>\n        </details>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"wrap\">\n      <div class=\"closing\">\n        <h2>最后一句实在话</h2>\n        <p>选套餐这件事，答案往往在你自己的用量记录里，而不在对比表里。先把上个月用了多少、同时开几台设备这两个数字写下来，剩下的判断会快很多。本页只负责把已经公示的内容摆清楚，不替你下结论。</p>\n      </div>\n    </div>\n  </section>\n\n  <footer>\n    <div class=\"wrap\">\n      <p>白嫖(Estars) · 订阅说明页 · 本页内容依据站内公示的套餐信息整理，不构成购买建议，也不代办任何交易。</p>\n    </div>\n  </footer>\n</main>\n\n<nav class=\"bottomnav\" aria-label=\"页面导航\">\n  <ul>\n    <li><span class=\"mark\">Estars</span></li>\n    <li><a href=\"#reading\">怎么读</a></li>\n    <li><a href=\"#plans\">套餐</a></li>\n    <li><a href=\"#steps\">使用步骤</a></li>\n    <li><a href=\"#clients\">客户端</a></li>\n    <li><a href=\"#faq\">常见问题</a></li>\n  </ul>\n</nav>",
